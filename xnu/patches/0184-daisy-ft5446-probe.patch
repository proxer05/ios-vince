+/*
+ * One combined register write / repeated START read, QUP v1 tags. The
+ * address byte uses DATA (not STOP), followed by START with the read bit.
+ * Input block mode and MX_IN_CNT permit a single snapshot larger than the
+ * FIFO. Acknowledge service flags while draining, not just at completion.
+ * The existing Synaptics START..STOP helper is deliberately unchanged.
+ */
+static int
+qup_reg_read(unsigned addr, uint8_t reg, uint8_t *buf, uint32_t n)
+{
+	uint32_t got = 0;
+	bool block = n >= qup_in_fifo;
+	int r = -1;
+
+	if (addr > 0x7f || !buf || !n || n > 255 || !qup_in_fifo || qup_out_fifo < 4) {
+		return -5;
+	}
+	in_wr(qup, QUP_SW_RESET, 1);
+	if (qup_poll(ST_RESET, ST_MASK)) {
+		goto out;
+	}
+	in_wr(qup, QUP_CONFIG, CFG_I2C);
+	if (qup_poll(ST_MAST_GEN, ST_MAST_GEN)) {
+		goto out;
+	}
+	in_wr(qup, QUP_MX_OUT_CNT, 0);
+	in_wr(qup, QUP_MX_WR_CNT, 4);  /* START-W, register, START-R, RECEIVE */
+	in_wr(qup, QUP_MX_IN_CNT, block ? n : 0);
+	in_wr(qup, QUP_MX_RD_CNT, block ? 0 : n);
+	in_wr(qup, QUP_IO_MODE, IO_REPACK | (block ? IO_IN_BLOCK : 0));
+	if (qup_set_state(ST_RUN)) {
+		goto out;
+	}
+	in_wr(qup, QUP_CLK_CTL, qup_clk_ctl);
+	if (qup_set_state(ST_PAUSE)) {
+		goto out;
+	}
+	in_wr(qup, QUP_OUT_FIFO, (TAG_START | (addr << 1)) | ((TAG_DATA | reg) << 16));
+	in_wr(qup, QUP_OUT_FIFO, (TAG_START | (addr << 1) | 1u) | ((TAG_REC | n) << 16));
+	if (qup_set_state(ST_RUN)) {
+		goto out;
+	}
+	for (unsigned t = 0; t < 4000; t++) {
+		if ((r = qup_check_err())) {
+			goto out;
+		}
+		uint32_t op = in_rd(qup, QUP_OPERATIONAL);
+		if (op & (OP_IN_SVC | OP_OUT_SVC)) {
+			in_wr(qup, QUP_OPERATIONAL, op & (OP_IN_SVC | OP_OUT_SVC));
+		}
+		while (got < n && (in_rd(qup, QUP_OPERATIONAL) & OP_IN_NOT_EMPTY)) {
+			uint32_t v = in_rd(qup, QUP_IN_FIFO);
+			buf[got++] = (uint8_t)v;
+			if (got < n) {
+				buf[got++] = (uint8_t)(v >> 16);
+			}
+		}
+		op = in_rd(qup, QUP_OPERATIONAL);
+		if (got == n && (op & OP_MX_IN_DONE) && !(op & OP_OUT_NOT_EMPTY) &&
+		    !(in_rd(qup, QUP_I2C_STATUS) & I2C_BUS_ACTIVE)) {
+			r = qup_check_err(); /* include a late NACK */
+			goto out;
+		}
+		delay(5);
+	}
+	r = -4;
+out:
+	if (r) {
+		/* An incomplete transfer must not leave the bus running. */
+		in_wr(qup, QUP_SW_RESET, 1);
+		(void)qup_poll(ST_RESET, ST_MASK);
+	} else {
+		in_wr(qup, QUP_OPERATIONAL, OP_OUT_SVC | OP_IN_SVC);
+		if (qup_set_state(ST_RESET)) {
+			in_wr(qup, QUP_SW_RESET, 1);
+			r = -1;
+		}
+	}
+	return r;
+}
