+static void
+fts_probe_summary(void)
+{
+	uint8_t hi = 0, lo = 0, fw = 0, vendor = 0, report[FTS_REPORT_LEN];
+	int r = qup_reg_read(FTS_ADDR, 0xa3, &hi, 1);
+	if (!r) {
+		r = qup_reg_read(FTS_ADDR, 0x9f, &lo, 1);
+	}
+	if (!r) {
+		r = qup_reg_read(FTS_ADDR, 0xa6, &fw, 1);
+	}
+	if (!r) {
+		r = qup_reg_read(FTS_ADDR, 0xa8, &vendor, 1);
+	}
+	if (r || hi != 0x54 || lo != 0x22) {
+		printf("DAISY TOUCH: probe failed %d id %02x%02x (expected 5422)\n", r, hi, lo);
+		return;
+	}
+	r = qup_reg_read(FTS_ADDR, 0, report, sizeof(report));
+	printf("DAISY TOUCH: FT5446 id %02x%02x fw %02x vendor %02x\n", hi, lo, fw, vendor);
+	printf("DAISY TOUCH: report63 %d count %u irq %u; probe only\n", r,
+	    r ? 0 : report[2] & 15u, in_rd(tlmm, GPIO_IO(GPIO_ATTN)) & 1u);
+}
+
+static void
+fts_probe_thread(void *arg, wait_result_t result)
+{
+	uint8_t hi = 0, lo = 0;
+	int r = -1;
+	(void)arg;
+	(void)result;
+	qup_clk_ctl = CLK_CTL_100K;
+	printf("DAISY TOUCH: FT5446 probe at 0x38, 100 kHz; no HID events\n");
+	if (!touch_hw_init()) {
+		goto out;
+	}
+	/* Normal application ID only: never enter the flash/bootloader protocol. */
+	for (unsigned i = 0; i < 10; i++) {
+		r = qup_reg_read(FTS_ADDR, 0xa3, &hi, 1);
+		if (!r) {
+			r = qup_reg_read(FTS_ADDR, 0x9f, &lo, 1);
+		}
+		if (!r && hi == 0x54 && lo == 0x22) {
+			break;
+		}
+		in_sleep(&touch_chan, 100);
+	}
+	fts_probe_summary();
+	if (r || hi != 0x54 || lo != 0x22) {
+		printf("DAISY TOUCH: check L10/L6 power and QUP3/pins before HID\n");
+	}
+	/* Bounded delayed summaries make the probe observable on the console. */
+	if (daisy_probe) {
+		for (unsigned i = 0; i < 2; i++) {
+			in_sleep(&touch_chan, 30000);
+			fts_probe_summary();
+		}
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
