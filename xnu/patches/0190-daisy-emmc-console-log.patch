diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 55c39c4..af5f067 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -284,6 +284,38 @@ sweet_log_append(const char *c, int size)
 	}
 	vince_conlog_pos = pos;
 }
+
+/* Thread-only snapshot for daisylog=1, restricted to the cpus=1 bring-up boot.
+ * The flush mutex excludes normal writers; masking IRQs excludes same-CPU
+ * direct/PPL output while copying. Never hold either across filesystem I/O.
+ */
+int daisy_console_read(uint64_t *, char *, unsigned, uint64_t *);
+int
+daisy_console_read(uint64_t *cursor, char *buf, unsigned capacity, uint64_t *lost)
+{
+	if (!cursor || !buf || !lost || !capacity || capacity > 16384) { return -1; }
+	*lost = 0;
+	if (!is_console_initialized() || console_suspended || kernel_debugger_entry_count) { return 0; }
+	lck_mtx_lock(&console_ring.flush_lock);
+	boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+	uint64_t end = vince_conlog_pos, start = *cursor;
+	int n = -1;
+	if (start <= end) {
+		if (end - start > sizeof(vince_conlog)) {
+			*lost = end - start - sizeof(vince_conlog);
+			start = end - sizeof(vince_conlog);
+		}
+		n = (int)MIN(end - start, capacity);
+		unsigned at = (unsigned)(start & (sizeof(vince_conlog) - 1));
+		unsigned first = (unsigned)MIN((unsigned)n, sizeof(vince_conlog) - at);
+		memcpy(buf, vince_conlog + at, first);
+		memcpy(buf + first, vince_conlog, (unsigned)n - first);
+		*cursor = start + (unsigned)n;
+	}
+	ml_set_interrupts_enabled(enabled);
+	lck_mtx_unlock(&console_ring.flush_lock);
+	return n;
+}
 #endif
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 extern void sweet_log_append(const char *c, int size);  /* bsd/dev/sweet_ufs.c */
