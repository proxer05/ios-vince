+static void
+fts_vince_crosscheck(void)
+{
+	uint32_t saved_clk = qup_clk_ctl;
+	printf("DAISY TOUCH: pins SDA %x/%u SCL %x/%u\n",
+	    in_rd(tlmm, GPIO_CTL(GPIO_SDA)), in_rd(tlmm, GPIO_IO(GPIO_SDA)) & 1u,
+	    in_rd(tlmm, GPIO_CTL(GPIO_SCL)), in_rd(tlmm, GPIO_IO(GPIO_SCL)) & 1u);
+	printf("DAISY TOUCH: reset %x/%u irq %x/%u\n",
+	    in_rd(tlmm, GPIO_CTL(GPIO_RST)), in_rd(tlmm, GPIO_IO(GPIO_RST)) & 1u,
+	    in_rd(tlmm, GPIO_CTL(GPIO_ATTN)), in_rd(tlmm, GPIO_IO(GPIO_ATTN)) & 1u);
+	printf("DAISY TOUCH: QUP3 clock cmd %x cfg %x cbcr %x\n",
+	    in_rd(gcc, 0), in_rd(gcc, 4), in_rd(gcc, 0x20));
+	for (unsigned speed = 0; speed < 2; speed++) {
+		uint8_t reg = 0xa3, hi = 0, lo = 0;
+		int r, stage = 1;
+		qup_clk_ctl = speed ? CLK_CTL_400K : CLK_CTL_100K;
+		qup_last_bus_error = qup_last_error = 0;
+		/* Vince's proven STOP-separated path, with only the slave changed. */
+		r = qup_msg(0, &reg, NULL, 1);
+		if (!r) {
+			stage = 2;
+			r = qup_msg(1, NULL, &hi, 1);
+		}
+		if (!r) {
+			reg = 0x9f;
+			stage = 3;
+			r = qup_msg(0, &reg, NULL, 1);
+		}
+		if (!r) {
+			stage = 4;
+			r = qup_msg(1, NULL, &lo, 1);
+		}
+		printf("DAISY TOUCH: STOP %uK r %d stage %d id %02x%02x\n",
+		    speed ? 400 : 100, r, stage, hi, lo);
+		printf("DAISY TOUCH: bus %x qup %x\n", qup_last_bus_error, qup_last_error);
+		hi = lo = 0;
+		qup_last_bus_error = qup_last_error = 0;
+		r = qup_reg_read(FTS_ADDR, 0xa3, &hi, 1);
+		if (!r) {
+			r = qup_reg_read(FTS_ADDR, 0x9f, &lo, 1);
+		}
+		printf("DAISY TOUCH: RESTART %uK r %d id %02x%02x\n",
+		    speed ? 400 : 100, r, hi, lo);
+		printf("DAISY TOUCH: bus %x qup %x\n", qup_last_bus_error, qup_last_error);
+	}
+	qup_clk_ctl = saved_clk;
+}
