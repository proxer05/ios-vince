+/* These are DMA buffers, not Apple-coherent memory. Use the real A53 PoC
+ * operation (flush_dcache can be compiled out by __ARM_COHERENT_CACHE__).
+ * CPU/user mappings are WC; the barrier also drains buffered CPU stores. */
+static void
+gpuToMemory(void *kernel, uint64_t size)
+{
+	FlushPoC_DcacheRegion((vm_offset_t)kernel, (unsigned)size);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static IOBufferMemoryDescriptor *
+gpuAllocate(uint64_t size, uint8_t **kernel, uint64_t *address)
+{
+	IOBufferMemoryDescriptor *memory = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(
+	    kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared |
+	    kIOMemoryPhysicallyContiguous | kIOMemoryMapperNone | kIOMapWriteCombineCache,
+	    (vm_size_t)size, 0x00000000fffff000ull);
+	if (memory == NULL) {
+		IOLog("VinceGPU: contiguous allocation failed (%llu bytes)\n", size);
+		return NULL;
+	}
+	IOByteCount length = 0;
+	*kernel = (uint8_t *)memory->getBytesNoCopy();
+	*address = memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+	/* Check the entire span; the first physical page alone is insufficient. */
+	if (*kernel == NULL || *address == 0 || (*address & PAGE_MASK) || length < size ||
+	    *address >= GPU_ADDRESS_LIMIT || size > GPU_ADDRESS_LIMIT - *address) {
+		IOLog("VinceGPU: invalid DMA span PA=%#llx length=%llu size=%llu\n",
+		    *address, (uint64_t)length, size);
+		memory->release();
+		return NULL;
+	}
+	/* Also evict any cached zero-fill left by the allocator. */
+	gpuToMemory(*kernel, size);
+	return memory;
+}
+
+static bool
+gpuMemoryTest(void)
+{
+	uint8_t *kernel;
+	uint64_t address;
+	const uint32_t size = 4 * PAGE_SIZE;
+	IOBufferMemoryDescriptor *memory = gpuAllocate(size, &kernel, &address);
+	if (memory == NULL) {
+		return false;
+	}
+	uint32_t fence = vince_gpu_memory_test(kernel, address, size);
+	bool done = fence != 0 && gpuWait(fence, GPU_WAIT_MS);
+	uint32_t got = *(volatile uint32_t *)(kernel + size - 4);
+	IOLog("VinceGPU: memory test PA=%#llx bytes=%u fence=%u done=%u value=%#x %s\n",
+	    address, size, fence, done, got, done && got == 0xc0ffee03u ? "PASS" : "FAIL");
+	if (fence == 0 || done) {
+		memory->release();
+	} else {
+		/* No GPU reset/recovery yet: never recycle memory still used by DMA. */
+		IOLog("VinceGPU: stalled memory test buffer retained until reboot\n");
+	}
+	return done && got == 0xc0ffee03u;
+}
