+/* daisygpu_test: fetch an IB across a page boundary and write the last
+ * dword of an allocator-backed buffer, outside the bring-up carveout. */
+uint32_t
+vince_gpu_memory_test(void *kernel, uint64_t address, uint32_t size)
+{
+	uint32_t off = PAGE_SIZE - 8;
+	volatile uint32_t *ib = (volatile uint32_t *)((uint8_t *)kernel + off);
+	uint64_t ib_address = address + off;
+	uint32_t words = 4;
+	extern void FlushPoC_DcacheRegion(vm_offset_t, unsigned);
+
+	if (size < 2 * PAGE_SIZE) {
+		return 0;
+	}
+	*(volatile uint32_t *)((uint8_t *)kernel + size - 4) = 0;
+	ib[0] = pkt7(CP_MEM_WRITE, 3);
+	ib[1] = (uint32_t)(address + size - 4);
+	ib[2] = 0;
+	ib[3] = 0xc0ffee03u;
+	FlushPoC_DcacheRegion((vm_offset_t)kernel, size);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return vince_gpu_submit(&ib_address, &words, 1);
+}
