+/* Opt-in DMA32 reserve: userspace has already fragmented RAM by its fifth
+ * frame. Keep page-aligned GEM spans in early contiguous WC chunks instead
+ * of repeatedly asking vm_page_find_contiguous for 12 MiB. This pool is GEM
+ * only; IOSurfaces still use the existing allocation/copy policy. */
+#define GPU_POOL_CHUNK (32u << 20)
+#define GPU_POOL_CHUNKS 16
+#define GPU_POOL_PAGES (GPU_POOL_CHUNK / PAGE_SIZE)
+struct gpu_pool_chunk {
+	IOBufferMemoryDescriptor *memory;
+	uint8_t *kernel;
+	uint64_t address;
+	/* PAGE_SIZE is a runtime variable in XNU's ARM kernel. Reserve enough
+	 * bits for its smallest supported page, then index using PAGE_SIZE. */
+	uint64_t used[GPU_POOL_CHUNK / PAGE_MIN_SIZE / 64];
+};
+static struct gpu_pool_chunk gPool[GPU_POOL_CHUNKS];
+static IOLock *gPoolLock;
+static uint32_t gPoolCount, gPoolUsed, gPoolPeak, gPoolMisses;
+
+static bool
+gpuPoolPageUsed(uint32_t chunk, uint32_t page)
+{
+	return (gPool[chunk].used[page / 64] & (1ull << (page % 64))) != 0;
+}
+
+/* Pool lock held. A bitmap coalesces adjacent freed spans automatically. */
+static void
+gpuPoolMark(uint32_t chunk, uint32_t first, uint32_t pages, bool used)
+{
+	for (uint32_t p = first; p < first + pages; p++) {
+		uint64_t bit = 1ull << (p % 64);
+		if (used) {
+			gPool[chunk].used[p / 64] |= bit;
+		} else {
+			gPool[chunk].used[p / 64] &= ~bit;
+		}
+	}
+	if (used) {
+		gPoolUsed += pages;
+		gPoolPeak = MAX(gPoolPeak, gPoolUsed);
+	} else {
+		gPoolUsed -= pages;
+	}
+}
+
+/* Use an independent physical descriptor, not IOSubMemoryDescriptor:
+ * XNU's subdescriptor mappings retain the parent, not the slice. A GEM
+ * close must NOT recycle this range while a user mapping still exists.
+ * The reserve owns the physical pages; this descriptor owns their lease. */
+class VinceGPUPoolMemory : public IOGeneralMemoryDescriptor {
+	OSDeclareDefaultStructors(VinceGPUPoolMemory);
+public:
+	uint32_t chunk, first, pages;
+	void free() APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(VinceGPUPoolMemory, IOGeneralMemoryDescriptor);
+
+void
+VinceGPUPoolMemory::free()
+{
+	if (pages != 0) {
+		IOLockLock(gPoolLock);
+		gpuPoolMark(chunk, first, pages, false);
+		IOLockUnlock(gPoolLock);
+	}
+	IOGeneralMemoryDescriptor::free();
+}
+
+static void
+gpuPoolInit(void)
+{
+	int mb = 0;
+	PE_parse_boot_argn("daisygpu_pool", &mb, sizeof(mb));
+	if (mb <= 0 || gPoolLock != NULL) {
+		return;
+	}
+	mb = MIN(mb, (int)(GPU_POOL_CHUNKS * (GPU_POOL_CHUNK >> 20)));
+	uint32_t count = ((uint32_t)mb + (GPU_POOL_CHUNK >> 20) - 1) / (GPU_POOL_CHUNK >> 20);
+	gPoolLock = IOLockAlloc();
+	if (gPoolLock == NULL) {
+		return;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		struct gpu_pool_chunk *c = &gPool[i];
+		c->memory = gpuAllocate(GPU_POOL_CHUNK, &c->kernel, &c->address);
+		if (c->memory == NULL) {
+			break;
+		}
+		gPoolCount++;
+	}
+	IOLog("VinceGPU: GEM pool v1 reserved=%u MiB chunks=%u requested=%d MiB\n",
+	    gPoolCount * (GPU_POOL_CHUNK >> 20), gPoolCount, mb);
+}
+
+static IOMemoryDescriptor *
+gpuGemAllocate(uint64_t size, uint8_t **kernel, uint64_t *address)
+{
+	if (gPoolCount == 0) {
+		return gpuAllocate(size, kernel, address);
+	}
+	if (size == 0 || size > GPU_BUFFER_MAX || (size & PAGE_MASK)) {
+		return NULL;
+	}
+	uint32_t pages = (uint32_t)(size / PAGE_SIZE);
+	uint32_t best = GPU_POOL_PAGES + 1, bestChunk = 0, first = 0, largest = 0;
+	IOLockLock(gPoolLock);
+	for (uint32_t i = 0; i < gPoolCount; i++) {
+		for (uint32_t p = 0; p < GPU_POOL_PAGES;) {
+			if (gpuPoolPageUsed(i, p)) {
+				p++;
+				continue;
+			}
+			uint32_t start = p;
+			while (p < GPU_POOL_PAGES && !gpuPoolPageUsed(i, p)) {
+				p++;
+			}
+			uint32_t run = p - start;
+			largest = MAX(largest, run);
+			if (run >= pages && run < best) {
+				best = run;
+				bestChunk = i;
+				first = start;
+			}
+		}
+	}
+	if (best > GPU_POOL_PAGES) {
+		if (gPoolMisses++ < 8) {
+			IOLog("VinceGPU: GEM pool exhausted request=%llu used=%u KiB peak=%u KiB largest=%u KiB\n",
+			    size, gPoolUsed * (PAGE_SIZE / 1024), gPoolPeak * (PAGE_SIZE / 1024),
+			    largest * (PAGE_SIZE / 1024));
+		}
+		IOLockUnlock(gPoolLock);
+		/* A bounded failure, not another multi-second global VM scan. */
+		return NULL;
+	}
+	gpuPoolMark(bestChunk, first, pages, true);
+	IOLockUnlock(gPoolLock);
+
+	struct gpu_pool_chunk *c = &gPool[bestChunk];
+	uint64_t offset = (uint64_t)first * PAGE_SIZE;
+	IOAddressRange range = { c->address + offset, size };
+	VinceGPUPoolMemory *memory = OSTypeAlloc(VinceGPUPoolMemory);
+	IOOptionBits cache = (kIOMapWriteCombineCache >> kIOMapCacheShift) << kIOMemoryBufferCacheShift;
+	if (memory == NULL || !memory->initWithOptions(&range, 1, 0, NULL,
+	    kIODirectionInOut | kIOMemoryTypePhysical64 | kIOMemoryMapperNone | kIOMemoryThreadSafe | cache, NULL)) {
+		OSSafeReleaseNULL(memory);
+		IOLockLock(gPoolLock);
+		gpuPoolMark(bestChunk, first, pages, false);
+		IOLockUnlock(gPoolLock);
+		return NULL;
+	}
+	memory->chunk = bestChunk;
+	memory->first = first;
+	memory->pages = pages;
+	*kernel = c->kernel + offset;
+	*address = range.address;
+	/* Each new handle is zero-filled, including reused pool spans. Both the
+	 * reserve's kernel alias and exported GEM mappings are WC. */
+	bzero(*kernel, size);
+	gpuToMemory(*kernel, size);
+	return memory;
+}
