+	uint8_t *kernel = (uint8_t *)s->kernelAddress();
+	/* Never import cached, fragmented, or out-of-aperture memory into
+	 * the identity-mapped A5xx. Mesa can fall back to its copy path. */
+	if (OSDynamicCast(IOBufferMemoryDescriptor, s->memory) == NULL ||
+	    s->mapCache != kIOMapWriteCombineCache || kernel == NULL ||
+	    size == 0 || size > GPU_BUFFER_MAX || (size & PAGE_MASK) ||
+	    address == 0 || (address & PAGE_MASK) || length < size ||
+	    address >= GPU_ADDRESS_LIMIT || size > GPU_ADDRESS_LIMIT - address) {
+		s->release();
+		return kIOReturnUnsupported;
+	}
+	request->size = size;
+	request->offset = s->offset;
+	request->row_bytes = s->bytesPerRow;
+	request->width = s->width;
+	request->height = s->height;
+	request->pixel_format = s->pixelFormat;
+	request->planes = s->planeCount;
+	if (describe) {
