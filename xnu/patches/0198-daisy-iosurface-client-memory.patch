+/* Copy bounded structure input, including out-of-line IOKit requests. */
+static uint8_t *
+sweet_struct_in(IOExternalMethodArguments *args, uint32_t *len)
+{
+	uint64_t size = args->structureInputDescriptor != NULL ?
+	    args->structureInputDescriptor->getLength() : args->structureInputSize;
+	*len = 0;
+	if (size == 0 || size > SWEET_SURFACE_MAX_PROPS) {
+		return NULL;
+	}
+	IOMemoryMap *map = NULL;
+	const void *in = args->structureInput;
+	if (args->structureInputDescriptor != NULL) {
+		map = args->structureInputDescriptor->map(kIOMapReadOnly);
+		in = map != NULL ? (const void *)map->getVirtualAddress() : NULL;
+	}
+	uint8_t *copy = in != NULL ? (uint8_t *)IOMallocData((uint32_t)size) : NULL;
+	if (copy != NULL) {
+		memcpy(copy, in, (uint32_t)size);
+		*len = (uint32_t)size;
+	}
+	OSSafeReleaseNULL(map);
+	return copy;
+}
