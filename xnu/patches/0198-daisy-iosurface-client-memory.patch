+			uint8_t *out = (uint8_t *)IOMallocZeroData(total);
+			if (out == NULL) {
+				ret = kIOReturnNoMemory;
+			} else {
+				put32(out, 4, seed);
+				if (length != 0) {
+					memcpy(out + 8, ser->text(), length);
+				}
+				ret = sweet_struct_out(args, out, total);
+				IOFreeData(out, total);
+			}
+		}
+	} else if (ret == kIOReturnSuccess &&
+	    (args->structureOutputDescriptor != NULL || args->structureOutputSize != 0)) {
+		ret = sweet_struct_out(args, &seed, sizeof(seed));
+	}
+	OSSafeReleaseNULL(ser);
+	s->release();
+	return ret;
+}
+
+/* The fields selected by selector 27's mask, at state-page +0x30. */
+static void
+sweet_surface_bulk_update(uint8_t *bulk, const uint8_t *in, uint64_t size, uint64_t mask)
+{
+	static const uint8_t field[15][2] = {
+		{ 0x00, 0x20 }, { 0x20, 0x30 }, { 0x30, 0x38 }, { 0x38, 0x39 }, { 0x39, 0x3a },
+		{ 0x3a, 0x3b }, { 0x3b, 0x3c }, { 0x3c, 0x3d }, { 0x3d, 0x3e }, { 0x3e, 0x3f },
+		{ 0x3f, 0x40 }, { 0x40, 0x58 }, { 0x58, 0x5c }, { 0x5c, 0x64 }, { 0x64, 0x65 },
+	};
+	for (unsigned i = 0; i < 15; i++) {
+		if ((mask & (1ull << i)) && field[i][1] <= size) {
+			memcpy(bulk + field[i][0], in + field[i][0], field[i][1] - field[i][0]);
+		}
+	}
+}
+
+IOReturn
+IOSurfaceRootUserClient::bulkAttachments(IOExternalMethodArguments *args)
+{
+	uint32_t len, id;
+	uint8_t *in = sweet_struct_in(args, &len);
+	if (in == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (len < 0x88) {
+		IOFreeData(in, len);
+		return kIOReturnBadArgument;
+	}
+	uint64_t size, mask;
+	memcpy(&size, in + 0x70, 8);
+	memcpy(&mask, in + 0x78, 8);
+	memcpy(&id, in + 0x80, 4);
+	SweetSurface *s = size <= SWEET_SURFACE_BULK_SIZE ? sweet_surface_held(fLock, fRefs, id) : NULL;
+	IOReturn ret = size > SWEET_SURFACE_BULK_SIZE ? kIOReturnBadArgument : kIOReturnNotFound;
+	if (s != NULL) {
+		IOLockLock(sweet_surface_lock);
+		sweet_surface_bulk_update((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_BULK, in, size, mask);
+		IOLockUnlock(sweet_surface_lock);
+		s->release();
+		ret = kIOReturnSuccess;
+	}
+	IOFreeData(in, len);
+	return ret;
+}
