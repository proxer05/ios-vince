+/* Selector 6: address, width, height, format, bytes/element, bytes/row.
+ * Geometry is the caller's actual storage, including unaligned addresses. */
+static IOReturn
+sweet_surface_image_layout(SweetSurface *s, const uint8_t *in, uint32_t len, uint64_t *address)
+{
+	uint32_t bpe;
+	if (in == NULL || len < 0x1c) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(address, in, 8);
+	memcpy(&s->width, in + 8, 4);
+	memcpy(&s->height, in + 12, 4);
+	memcpy(&s->pixelFormat, in + 16, 4);
+	memcpy(&bpe, in + 20, 4);
+	memcpy(&s->bytesPerRow, in + 24, 4);
+	uint64_t size = (uint64_t)s->bytesPerRow * s->height;
+	if (s->width == 0 || s->width > SWEET_SURFACE_MAX_DIM ||
+	    s->height == 0 || s->height > SWEET_SURFACE_MAX_DIM || bpe == 0 || bpe > 16 ||
+	    s->bytesPerRow < (uint64_t)s->width * bpe || size > SWEET_SURFACE_MAX_ALLOC) {
+		return kIOReturnBadArgument;
+	}
+	s->bytesPerElement = (uint16_t)bpe;
+	s->elementWidth = s->elementHeight = 1;
+	s->allocSize = (uint32_t)size;
+	return kIOReturnSuccess;
+}
