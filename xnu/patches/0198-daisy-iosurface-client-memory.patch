+/* Pin the original pixels, retaining the prepared descriptor until free().
+ * Kernel and user mappings stay cached. They are never direct GPU imports. */
+static IOReturn
+sweet_surface_use_task_memory(SweetSurface *s, task_t task, uint64_t address, uint64_t size)
+{
+	if (address == 0 || size == 0 || size > SWEET_SURFACE_MAX_ALLOC ||
+	    address > ~0ULL - size - PAGE_MASK) {
+		return kIOReturnBadArgument;
+	}
+	uint64_t first = trunc_page_64(address);
+	uint64_t length = round_page_64(address + size) - first;
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(first, length, kIODirectionInOut, task);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	IOReturn ret = md->prepare();
+	if (ret != kIOReturnSuccess) {
+		md->release();
+		return ret;
+	}
+	s->memory = md;
+	s->wrapped = true;
+	s->wrapDelta = (uint32_t)(address - first);
+	s->mapCache = kIOMapDefaultCache;
+	return kIOReturnSuccess;
+}
