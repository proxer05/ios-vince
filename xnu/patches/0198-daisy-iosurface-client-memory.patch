+IOReturn
+IOSurfaceRootUserClient::wrapClient(uint32_t selector, IOExternalMethodArguments *args)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return kIOReturnNoMemory;
+	}
+	uint64_t address = 0;
+	IOReturn ret = kIOReturnBadArgument;
+	if (selector == kSweetSurfaceWrapClientImage) {
+		uint32_t len;
+		uint8_t *in = sweet_struct_in(args, &len);
+		ret = sweet_surface_image_layout(s, in, len, &address);
+		if (in != NULL) {
+			IOFreeData(in, len);
+		}
+	} else if (args->scalarInputCount == 2 && args->scalarInput[1] != 0 &&
+	    args->scalarInput[1] <= SWEET_SURFACE_MAX_ALLOC) {
+		address = args->scalarInput[0];
+		s->width = s->bytesPerRow = s->allocSize = (uint32_t)args->scalarInput[1];
+		s->height = s->bytesPerElement = s->elementWidth = s->elementHeight = 1;
+		ret = kIOReturnSuccess;
+	}
+	if (ret == kIOReturnSuccess) {
+		ret = sweet_surface_use_task_memory(s, fTask, address, s->allocSize);
+	}
+	if (ret == kIOReturnSuccess) {
+		ret = sweet_surface_publish(s) ? returnSurface(s, args) : kIOReturnNoResources;
+	}
+	static uint32_t told;
+	if (told++ < 12) {
+		IOLog("SWEET SURF: wrap sel %u id %u %ux%u fmt 0x%x bpr %u size %u delta %u -> 0x%x\n",
+		    selector, s->id, s->width, s->height, s->pixelFormat, s->bytesPerRow,
+		    s->allocSize, s->wrapDelta, ret);
+	}
+	s->release();
+	return ret;
+}
