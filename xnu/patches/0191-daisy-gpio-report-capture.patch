+#define FTS_CAPTURE_MS 300000u
+#define FTS_CAPTURE_LIMIT 4096u
+
+static uint64_t
+fts_capture_elapsed(uint64_t start)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	return ns / NSEC_PER_MSEC;
