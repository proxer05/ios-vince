+/* One combined register-0 read per frame, as in Daisy's vendor driver.
+ * Observe IRQ on both sides but poll regardless: its falling edge may be a pulse.
+ * Keep the full raw frame for host validation; no contact state or HID here.
+ */
+static void
+fts_gpio_capture(void)
+{
+	uint8_t report[FTS_REPORT_LEN], previous[FTS_REPORT_LEN];
+	uint64_t start = mach_absolute_time(), last_log = 0;
+	unsigned reads = 0, good = 0, errors = 0, consecutive = 0, raw = 0, check = 30000;
+	const char *reason = "time";
+	printf("DAISY REPORT: begin reg00 bytes63 interval20ms duration300000ms limit4096; no HID\n");
+	while (fts_capture_elapsed(start) < FTS_CAPTURE_MS) {
+		uint64_t ms = fts_capture_elapsed(start);
+		unsigned stage = 0, received = 0;
+		bool irq_before = fts_gpio_level(GPIO_ATTN);
+		int r = fts_gpio_read_block(0, report, sizeof(report), &stage, &received);
+		bool irq_after = fts_gpio_level(GPIO_ATTN);
+		reads++;
+		if (!r && received != sizeof(report)) { r = -7; }
+		if (r) {
+			errors++;
+			consecutive++;
+			if (errors <= 8 || !(errors % 100)) {
+				printf("DAISY REPORT: error seq%u ms%llu r%d stage%u got%u consecutive%u\n",
+				    reads, (unsigned long long)ms, r, stage, received, consecutive);
+			}
+			if (consecutive == 8) { reason = "i2c"; break; }
+		} else {
+			good++;
+			consecutive = 0;
+			if (good == 1 || memcmp(report, previous, sizeof(report)) || ms - last_log >= 1000) {
+				static const char digits[] = "0123456789abcdef";
+				char hex[2 * FTS_REPORT_LEN + 1];
+				for (unsigned i = 0; i < sizeof(report); i++) {
+					hex[2 * i] = digits[report[i] >> 4];
+					hex[2 * i + 1] = digits[report[i] & 15];
+				}
+				hex[sizeof(hex) - 1] = 0;
+				printf("DAISY REPORT: seq%u ms%llu irq%u/%u got63 data%s\n",
+				    reads, (unsigned long long)ms, irq_before, irq_after, hex);
+				last_log = ms;
+				if (++raw == FTS_CAPTURE_LIMIT) { reason = "limit"; break; }
+			}
+			memcpy(previous, report, sizeof(report));
+		}
+		if (daisy_probe && ms >= check && check <= 60000) {
+			fts_rail_summary();
+			if (!fts_gpio_summary()) { reason = "identity"; break; }
+			check += 30000;
+		}
+		in_sleep(&touch_chan, 20);
+	}
+	printf("DAISY REPORT: done ms%llu reads%u ok%u errors%u raw%u reason%s\n",
+	    (unsigned long long)fts_capture_elapsed(start), reads, good, errors, raw, reason);
 }
 
