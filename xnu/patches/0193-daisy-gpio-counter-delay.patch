+/* GPIO-local alternative to delay(): ARM's generic path can block a thread
+ * or enter WFE (osfmk/kern/clock.c, osfmk/arm/rtclock.c), overshooting 5 us.
+ * Keep interrupts/preemption enabled; no frame-wide critical section. Long
+ * scheduling gaps remain observable in the optional per-byte timing trace.
+ */
+static void
+fts_gpio_busy_delay(unsigned usec)
+{
+	uint64_t ticks;
+	clock_interval_to_absolutetime_interval(usec, NSEC_PER_USEC, &ticks);
+	uint64_t start = mach_absolute_time();
+	while (mach_absolute_time() - start < ticks) {
+		__asm__ volatile("" ::: "memory");
+	}
+}
+
+static void
+fts_gpio_delay(unsigned usec)
+{
+	if (daisy_busywait == 1) { fts_gpio_busy_delay(usec); }
+	else { delay(usec); }
+}
+
+static void
+fts_gpio_delay_check(void)
+{
+	/* With reset held, compare both delay paths without touching the I2C bus. */
+	for (unsigned mode = 0; mode < 2; mode++) {
+		uint64_t min = ~0ull, sum = 0, max = 0;
+		for (unsigned i = 0; i < 32; i++) {
+			uint64_t start = mach_absolute_time(), ns;
+			if (mode) { fts_gpio_busy_delay(FTS_GPIO_HALF_US); }
+			else { delay(FTS_GPIO_HALF_US); }
+			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+			if (ns < min) { min = ns; }
+			if (ns > max) { max = ns; }
+			sum += ns;
+		}
+		printf("DAISY TOUCH: delay5 %s us%llu/%llu/%llu samples32\n", mode ? "busy" : "legacy",
+		    (unsigned long long)(min / 1000u), (unsigned long long)(sum / 32000u),
+		    (unsigned long long)(max / 1000u));
+	}
+}
