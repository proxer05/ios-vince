+/* Relative microseconds, including observation overhead and scheduling.
+ * IRQ low bit 0 is sampled before START; bit n follows completed byte n.
+ * These 64 observations can miss pulses: this is not an interrupt counter.
+ */
+struct fts_gpio_trace {
+	uint64_t start, setup, header, point0, point1, data, total, gap, low;
+};
+
+static uint64_t
+fts_trace_us(uint64_t start)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	return ns / 1000u;
+}
